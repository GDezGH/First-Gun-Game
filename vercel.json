{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'static site - no dependencies'",
  "buildCommand": "mkdir -p out && cp index.html out/ && cp -r css js vendor out/",
  "outputDirectory": "out",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
